# Copy this file to .env and paste your own API key.
# Never put this key in index.html or share it publicly.
OPENAI_API_KEY=your_api_key_here

# Change this to a model available to your OpenAI API project if needed.
OPENAI_MODEL=gpt-5.5

# Optional: comma-separated origins when hosting the frontend separately.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
LOG_LEVEL=INFO
